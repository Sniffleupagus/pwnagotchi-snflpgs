#!/usr/bin/env bash
source /usr/bin/pwnlib


MIN_UPTIME=10
now=$(cat /proc/uptime | cut -d . -f 1)
if [ $now -lt ${MIN_UPTIME} ]; then
  echo "*** monstart: Too soon.  Waiting $((${MIN_UPTIME}-${now}))"
  sleep $((${MIN_UPTIME}-${now}))
else
  echo "*** monstart: all good in the hood $now"
fi

(
flock -x -w 10 200
if [ ! -e /sys/class/net/${PWNY_MON_IFACE} -o "$(cat /sys/class/net/${PWNY_MON_IFACE}/type)" != "803" -o "$(cat /sys/class/net/${PWNY_MON_IFACE}/operstate)" = "down" ]; then
  if [ ! -e /sys/class/net/${PWNY_WIFI_IFACE} ]; then
    echo "\t\t\t\t Reloading brcmfmac"
    reload_brcm
  fi
  start_monitor_interface
fi
) 200>/tmp/.monitor_mode.exclusivelock
